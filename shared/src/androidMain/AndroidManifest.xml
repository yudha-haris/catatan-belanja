<?xml version="1.0" encoding="utf-8"?>
<!--
    The module that makes the call declares the permission it needs, rather than relying on the
    app to remember. The manifest merger unions these into `:androidApp`, which states them again
    for the reader.

    Both exist for the receipt scanner and nothing else (docs/architecture.md §6b): INTERNET to
    send the photograph, ACCESS_NETWORK_STATE so `AndroidNetworkMonitor` can say "you are offline"
    before the user takes it. Neither is a runtime permission.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
</manifest>
