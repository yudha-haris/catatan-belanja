-- v1 -> v2: the shopping list ("daftar belanja") — what the trip is *supposed* to buy.
-- Fresh installs get these from ShoppingList.sq / ShoppingListItem.sq; existing databases
-- (anyone already using the app) get them here.
CREATE TABLE shopping_list (
    id          TEXT NOT NULL PRIMARY KEY,
    name        TEXT NOT NULL DEFAULT '',
    created_at  INTEGER NOT NULL,
    updated_at  INTEGER NOT NULL,
    is_template INTEGER NOT NULL DEFAULT 0,
    archived_at INTEGER
);

CREATE INDEX shopping_list_state ON shopping_list(is_template, archived_at);

CREATE TABLE shopping_list_item (
    id       TEXT NOT NULL PRIMARY KEY,
    list_id  TEXT NOT NULL REFERENCES shopping_list(id) ON DELETE CASCADE,
    name     TEXT NOT NULL,
    note     TEXT NOT NULL DEFAULT '',
    checked  INTEGER NOT NULL DEFAULT 0,
    position INTEGER NOT NULL DEFAULT 0
);

CREATE INDEX shopping_list_item_list_id ON shopping_list_item(list_id);
