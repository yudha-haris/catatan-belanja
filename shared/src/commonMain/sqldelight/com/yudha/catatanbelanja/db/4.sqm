-- v4 -> v5: the presets. The item catalog used to be a hardcoded Kotlin table; it now lives
-- here so "Pengaturan > Preset" can edit it, and brands the user keeps retyping get a list of
-- their own. Fresh installs run the CREATE statements in CatalogCategory.sq / CatalogItem.sq /
-- BrandPreset.sq instead, so these must stay byte-identical to those.
--
-- No rows are seeded here: the built-in catalog is a Kotlin data structure (CatalogData), and a
-- migration cannot reach it. CatalogRepositoryImpl writes it on first read instead, guarded by
-- a settings flag so a user who deletes a category does not get it back on next launch.
CREATE TABLE catalog_category (
    id       TEXT NOT NULL PRIMARY KEY,
    name     TEXT NOT NULL,
    emoji    TEXT NOT NULL DEFAULT '',
    position INTEGER NOT NULL DEFAULT 0
);

CREATE TABLE catalog_item (
    id           TEXT NOT NULL PRIMARY KEY,
    category_id  TEXT NOT NULL REFERENCES catalog_category(id) ON DELETE CASCADE,
    name         TEXT NOT NULL,
    default_unit TEXT NOT NULL DEFAULT '',
    position     INTEGER NOT NULL DEFAULT 0
);

CREATE INDEX catalog_item_category_id ON catalog_item(category_id);

CREATE TABLE brand_preset (
    id       TEXT NOT NULL PRIMARY KEY,
    name     TEXT NOT NULL,
    position INTEGER NOT NULL DEFAULT 0
);
