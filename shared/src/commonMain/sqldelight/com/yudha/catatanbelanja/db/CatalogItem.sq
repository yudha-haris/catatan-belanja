-- The catalog's items ("belanjaan"). `default_unit` is the prototype's UNIT_DEFAULT entry for
-- the name: empty means the app has no opinion and falls back to the first unit.
CREATE TABLE catalog_item (
    id           TEXT NOT NULL PRIMARY KEY,
    category_id  TEXT NOT NULL REFERENCES catalog_category(id) ON DELETE CASCADE,
    name         TEXT NOT NULL,
    default_unit TEXT NOT NULL DEFAULT '',
    position     INTEGER NOT NULL DEFAULT 0
);

CREATE INDEX catalog_item_category_id ON catalog_item(category_id);

selectAll:
SELECT *
FROM catalog_item
ORDER BY category_id ASC, position ASC;

selectMaxPosition:
SELECT position
FROM catalog_item
WHERE category_id = ?
ORDER BY position DESC
LIMIT 1;

insert:
INSERT INTO catalog_item (id, category_id, name, default_unit, position)
VALUES (?, ?, ?, ?, ?);

update:
UPDATE catalog_item
SET category_id = :categoryId, name = :name, default_unit = :defaultUnit
WHERE id = :id;

deleteById:
DELETE FROM catalog_item
WHERE id = ?;

deleteByCategoryId:
DELETE FROM catalog_item
WHERE category_id = ?;

deleteAll:
DELETE FROM catalog_item;
