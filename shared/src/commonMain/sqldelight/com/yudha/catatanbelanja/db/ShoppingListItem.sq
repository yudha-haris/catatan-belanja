CREATE TABLE shopping_list_item (
    id       TEXT NOT NULL PRIMARY KEY,
    list_id  TEXT NOT NULL REFERENCES shopping_list(id) ON DELETE CASCADE,
    name     TEXT NOT NULL,
    note     TEXT NOT NULL DEFAULT '',
    checked  INTEGER NOT NULL DEFAULT 0,
    position INTEGER NOT NULL DEFAULT 0     -- ascending == the order they were written down
);

CREATE INDEX shopping_list_item_list_id ON shopping_list_item(list_id);

selectByListId:
SELECT *
FROM shopping_list_item
WHERE list_id = ?
ORDER BY position ASC;

selectByListIds:
SELECT *
FROM shopping_list_item
WHERE list_id IN ?
ORDER BY list_id ASC, position ASC;

selectMaxPosition:
SELECT position
FROM shopping_list_item
WHERE list_id = ?
ORDER BY position DESC
LIMIT 1;

insert:
INSERT INTO shopping_list_item (id, list_id, name, note, checked, position)
VALUES (?, ?, ?, ?, ?, ?);

update:
UPDATE shopping_list_item
SET name = :name, note = :note
WHERE id = :id AND list_id = :listId;

setChecked:
UPDATE shopping_list_item
SET checked = :checked
WHERE id = :id AND list_id = :listId;

deleteById:
DELETE FROM shopping_list_item
WHERE id = :id AND list_id = :listId;

deleteByListId:
DELETE FROM shopping_list_item
WHERE list_id = ?;

deleteAll:
DELETE FROM shopping_list_item;
