-- Brands the user keeps typing ("Bimoli", "Indomie goreng"). One flat list, offered for any
-- item: the per-item brand chips still come from what past trips recorded.
CREATE TABLE brand_preset (
    id       TEXT NOT NULL PRIMARY KEY,
    name     TEXT NOT NULL,
    position INTEGER NOT NULL DEFAULT 0
);

selectAll:
SELECT *
FROM brand_preset
ORDER BY position ASC;

selectMaxPosition:
SELECT position
FROM brand_preset
ORDER BY position DESC
LIMIT 1;

insert:
INSERT INTO brand_preset (id, name, position)
VALUES (?, ?, ?);

update:
UPDATE brand_preset
SET name = :name
WHERE id = :id;

deleteById:
DELETE FROM brand_preset
WHERE id = ?;

deleteAll:
DELETE FROM brand_preset;
